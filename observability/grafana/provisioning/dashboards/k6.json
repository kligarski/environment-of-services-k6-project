{
  "title": "k6 Load Test",
  "uid": "k6-load-test",
  "schemaVersion": 38,
  "version": 4,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "testrun_name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(testrun_name)",
        "query": "label_values(testrun_name)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Virtual Users",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "max(vus{testrun_name=~\"$testrun_name\"})",
          "legendFormat": "Total VUs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Throughput by Tool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "sum(rate(mcp_request_count_total{testrun_name=~\"$testrun_name\"}[1m])) by (group)",
          "legendFormat": "{{group}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency by Tool (P95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(mcp_request_duration_bucket{testrun_name=~\"$testrun_name\"}[1m])) by (le, group))",
          "legendFormat": "{{group}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Iteration Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "lineWidth": 2 } }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(iteration_duration_milliseconds_bucket{testrun_name=~\"$testrun_name\"}[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(iteration_duration_milliseconds_bucket{testrun_name=~\"$testrun_name\"}[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ]
    }
  ]
}
